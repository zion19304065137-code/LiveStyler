{
  "name": "livestyler-online",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "vinext dev --port 5173",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node tests/core.mjs && node tests/product.mjs && node tests/render-export.mjs && node tests/canvas-react.mjs && node tests/image-quality.mjs && node tests/split-art.mjs && node tests/packaging-plan.mjs && node tests/workflow.mjs && node tests/scrub.mjs && node tests/live-capture.mjs && node tests/polyv-accounts.mjs && node tests/channel-sync.mjs && node tests/cloud-services.mjs && node tests/account-assets.mjs && node tests/typing-preview.mjs",
    "test:templates": "node tests/studio-templates.mjs",
    "test:masks": "node tests/image-masks.mjs",
    "typecheck": "tsc --noEmit",
    "test:direct": "node tests/visitor-session.mjs && node tests/channel-direct.mjs",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "setup:owner": "node scripts/setup-owner.mjs",
    "secrets:upload": "node scripts/upload-owner-secrets.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "prepare:assets": "node scripts/import-ai-templates.mjs public/ai-templates && node scripts/build-template-art.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "pretypecheck": "npm run prepare:assets",
    "pretest": "npm run prepare:assets",
    "pretest:templates": "npm run prepare:assets",
    "pretest:masks": "npm run prepare:assets",
    "pretest:direct": "npm run prepare:assets"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "konva": "^10.7.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-konva": "^19.2.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@napi-rs/canvas": "0.1.100",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
